<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DeviceDefault follows One UI on Samsung phones, including dark mode. -->
    <style name="Theme.GojoDock" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
    </style>
</resources>
