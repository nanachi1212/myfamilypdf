#!/bin/bash

mkdir -p install/DEBIAN/
file="install/DEBIAN/control"

>$file
echo "Package: familypdf" >>$file
echo "Version: ${FAMILYPDF_VERSION}" >>$file
echo "Section: base" >>$file
echo "Priority: optional" >>$file
echo "Architecture: amd64" >>$file
echo "Maintainer: Jakub Melka" >>$file
echo "Description: FamilyPDF PDF viewer, editor, and document toolkit." >>$file
echo "Homepage: https://jakubmelka.github.io/" >>$file
echo "Vcs-Browser: https://github.com/nanachi1212/myfamilypdf" >>$file


dpkg-deb --build install

mv install.deb FamilyPDF-${FAMILYPDF_VERSION}.deb






